NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared-session SSO across *.merqo.io kits — leave unset in dev/preview
# (they don't run on merqo.io; setting this there breaks login instead of
# just failing to share it). Set to .merqo.io in Vercel Production only.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Per-kit outbound status-callback config (callback_url/callback_secret) now
# lives in printkit.kit_api_keys, not env vars — see scripts/create-kit-key.mjs
# and src/lib/kit-callback.ts. Nothing to set here.
