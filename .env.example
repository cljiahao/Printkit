NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared-session SSO across *.merqo.io kits — leave unset in dev/preview
# (they don't run on merqo.io; setting this there breaks login instead of
# just failing to share it). Set to .merqo.io in Vercel Production only.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# MERQO_METRICS_SECRET and MERQO_PROVISION_SECRET must be two DIFFERENT secret values — a leak of one must not grant the other's capability.
MERQO_METRICS_SECRET=
MERQO_PROVISION_SECRET=
# Payment provider selector — "direct" (default) wraps the existing EMVCo/pointer builder unchanged. Unset or unrecognized falls back to "direct" with a warning; never leave a stray value that doesn't match a registered provider.
PAYKIT_PROVIDER=
