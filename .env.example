NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared-session SSO across *.merqo.io kits — leave unset in dev/preview
# (they don't run on merqo.io; setting this there breaks login instead of
# just failing to share it). Set to .merqo.io in Vercel Production only.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# Per-kit outbound status-callback config (callback_url/callback_secret) now
# lives in printkit.kit_api_keys, not env vars — see scripts/create-kit-key.mjs
# and src/lib/kit-callback.ts. Nothing to set here.
# New: printkit's first kit -> merqo outbound HTTP call (distinct from
# kit_api_keys above, which is printkit's own INBOUND bearer-auth for other
# kits — e.g. qkit — calling INTO printkit). Used by src/lib/legal-gate.ts and
# src/app/legal/accept/actions.ts to check/record a vendor's terms/privacy
# acceptance with merqo. MERQO_CUSTOMER_SECRET is sent as
# `Authorization: Bearer <value>` and must equal the value merqo's own
# MERQO_CUSTOMER_SECRET env var records (same shared secret every other kit
# uses for this direction). Server-only; unset here fails the legal gate
# CLOSED — every signed-in vendor gets bounced to /legal/accept and the accept
# action throws — so set both for any environment where vendors sign in.
MERQO_BASE_URL=
MERQO_CUSTOMER_SECRET=
# Feie cloud printers (the `vendor_cloud` connector, src/lib/connectors/
# vendor-cloud/feie.ts). Merqo holds ONE Feie developer account; a vendor's
# printer is added to it during setup, so these are platform credentials,
# not per-vendor ones. Server-only, read at request time: unset simply makes
# every Feie call fail with "Feie is not configured" rather than breaking
# boot. FEIE_API_BASE defaults to the Asia-Pacific station
# (https://api.jp.feieyun.com/Api/Open/) and only needs setting to point at
# another station or a test double.
FEIE_USER=
FEIE_UKEY=
FEIE_API_BASE=
# PEM public key used to verify Feie's own print-result callbacks
# (src/app/api/feie/callback/route.ts). Feie publishes it as public.key in
# its open-platform docs ("打印状态回调"). Unset fails CLOSED: every callback
# is rejected with 401 and jobs fall back to the sweep's status query
# instead. The callback URL (<PRINTKIT_PUBLIC_URL>/api/feie/callback) must
# also be whitelisted in Feie's developer console, or Feie never calls it.
FEIE_CALLBACK_PUBLIC_KEY=
# The absolute origin printers reach printkit on (src/lib/site-url.ts): the
# address a Star CloudPRNT printer is given at setup, and Feie's callback
# URL. Optional on Vercel, where VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL
# are used instead; required anywhere else, or printer setup refuses to
# hand out a relative URL no printer could use.
PRINTKIT_PUBLIC_URL=
