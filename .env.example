NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared-session SSO across *.merqo.io kits — leave unset in dev/preview
# (they don't run on merqo.io; setting this there breaks login instead of
# just failing to share it). Set to .merqo.io in Vercel Production only.
NEXT_PUBLIC_AUTH_COOKIE_DOMAIN=
# MERQO_METRICS_SECRET and MERQO_PROVISION_SECRET must be two DIFFERENT secret values — a leak of one must not grant the other's capability.
MERQO_METRICS_SECRET=
MERQO_PROVISION_SECRET=
# Shared secret for printkit's outbound callback to qkit's
# POST /api/printkit/print-status on job status change. No fallback exists
# on purpose — if unset, the callback is skipped (logged), never sent to
# an unclaimed/wrong host.
QKIT_CALLBACK_SECRET=
# qkit's deployment URL for the callback above, e.g. https://qkit-sg.vercel.app.
# NEXT_PUBLIC_* vars are inlined into the client bundle at Vercel BUILD time —
# changing this in an env dashboard requires a redeploy to take effect, unlike
# server-only secrets.
NEXT_PUBLIC_QKIT_URL=
