[Unit]
Description=printkit bridge (prints label jobs on a Bluetooth printer)
After=network-online.target bluetooth.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/printkit-bridge
ExecStart=/usr/bin/env node /opt/printkit-bridge/dist/cli.js run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# The Bluetooth library talks to the adapter over a raw HCI socket, which
# Linux only allows with these two capabilities. Granted here rather than
# with setcap on the node binary, so no other program on the Pi gets them.
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN

# The agent only needs its own config file and Bluetooth; nothing else on
# the Pi is its business.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.printkit-bridge

[Install]
WantedBy=multi-user.target
